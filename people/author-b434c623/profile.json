{"id":"ac5879@princeton.edu","name":"Anna Calveri","counts":{"accepted_papers":1,"first_position_papers":0,"co_first_author_papers":null,"corresponding_author_papers":null,"Poster only":1},"papers":[{"id":"ecN9efL5zs","title":"Procedural Generation of Articulated Simulation-Ready Assets","abstract":"We introduce Infinigen-Articulated, a toolkit for generating realistic, procedurally generated articulated assets for robotics simulation. We include procedural generators for 18 common articulated object categories along with high-level utilities for use creating custom articulated assets in Blender. We also provide an export pipeline to integrate the resulting assets along with their physical properties into common robotics simulators. Experiments demonstrate that assets sampled from these generators are effective for movable object segmentation, training generalizable reinforcement learning policies, and sim-to-real transfer of imitation learning policies.","summary":null,"type":"Poster only","topics":["强化学习与奖励","模仿与示范学习","世界模型与仿真","安全、泛化与鲁棒性"],"title_topics":["世界模型与仿真"],"authors":["~Abhishek_Joshi1","~Beining_Han1","~Jack_Nugent1","~Max_Gonzalez_Saez-Diez1","~Yiming_Zuo2","~Jonathan_Liu1","~Hongyu_Wen1","~Stamatis_Alexandropoulos1","~Karhan_Kayan1","ac5879@princeton.edu","~Tao_Sun25","~Gaowen_Liu4","~Yi_Shao1","~Alexander_Raistrick1","~Jia_Deng1"],"institutions":["Cisco","McGill University","Princeton University"],"pdf":"https://arxiv.org/pdf/2505.10755","openreview":"https://openreview.net/forum?id=ecN9efL5zs","project":[],"code":[],"poster_date":"2026-11-09","poster_time":"5:00–6:30 PM","poster_venue":"JW Marriott","poster_number":197,"hardware":[],"has_social_sample":false,"role_evidence":null,"author_role":{"id":"ecN9efL5zs","position":10,"first":false,"roles":[]}}],"topics":{"强化学习与奖励":1,"模仿与示范学习":1,"世界模型与仿真":1,"安全、泛化与鲁棒性":1},"role_counts":{},"role_papers_reviewed":0,"profile":null,"portfolio":null,"needs_identifier_review":true,"affiliation_evidence":{"direct":[